{
  "name": "@jeftelabs/intl",
  "version": "1.0.0",
  "description": "JavaScript Internationalization API, memoized for speed and performance",
  "type": "module",
  "files": [
    "build",
    "!build/benchmarks",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "benchmark": "node --import=@jeftelabs/exec benchmarks/date.js && node --import=@jeftelabs/exec benchmarks/number.js && node --import=@jeftelabs/exec benchmarks/plural.js && node --import=@jeftelabs/exec benchmarks/relative.js && node --import=@jeftelabs/exec benchmarks/list.js && node --import=@jeftelabs/exec benchmarks/display_names.js",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "quick:test": "node --import=@jeftelabs/exec --enable-source-maps bin/test.ts",
    "prepare": "husky",
		"commitlint": "commitlint --edit",
		"commit": "cz"
  },
  "devDependencies": {
    "@arapucajs/eslint-config": "^1.1.2",
		"@arapucajs/prettier": "^1.1.1",
		"@arapucajs/tsconfig": "^1.0.0",
    "@t8ngs/assert": "^1.0.0",
    "@t8ngs/runner": "^1.0.0",
    "@jeftelabs/exec": "^1.0.1",
    "@types/node": "^25.0.5",
    "benchmark": "^2.1.4",
    "c8": "^10.1.3",
    "commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "micro-memoize": "^5.1.1"
  },
  "homepage": "https://github.com/jeftelabs/intl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeftelabs/intl.git"
  },
  "bugs": {
    "url": "https://github.com/jeftelabs/intl/issues"
  },
  "keywords": [
    "intl",
    "formatjs"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@arapucajs/prettier",
  "config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"husky": {
		"hooks": {
			"prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
		}
	}
}
